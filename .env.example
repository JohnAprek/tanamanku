# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env
#
# Cara tahu nilai N8N_HOST:
#   jalankan `tailscale status` di laptop, atau buka admin console Tailscale.
#   Bentuknya seperti:  tanamanku.tailabcd.ts.net  (huruf kecil semua)

# --- Akses lewat Tailscale (HTTPS) ---
N8N_HOST=ganti-dengan-nama.tailabcd.ts.net
N8N_PROTOCOL=https
WEBHOOK_URL=https://ganti-dengan-nama.tailabcd.ts.net/

# --- Zona waktu ---
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta
